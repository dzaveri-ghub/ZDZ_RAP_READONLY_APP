managed implementation in class ZZBP_R_DZDT_CUSTOMER unique;
strict ( 2 );
with draft;
extensible;
define behavior for ZZR_DZDT_CUSTOMER alias ZzrDzdtCustomer
persistent table ZDZ_DT_CUSTOMER
extensible
draft table ZZDZDT_CSTOMER_D
etag master LocalLastChanged
lock master total etag LastChanged
authorization master( global )
{
  field ( mandatory : create )
   CustID;

  field ( readonly )
   LocalLastChanged,
   LastChanged,
   LocalChangedBy,
   LastChangedBy;

  field ( readonly : update )
   CustID;


  create;
  update;
  delete;

  draft action Activate optimized;
  draft action Discard;
  draft action Edit;
  draft action Resume;
  draft determine action Prepare;

  mapping for ZDZ_DT_CUSTOMER corresponding extensible
  {
    CustID = CUST_ID;
    Name = NAME;
    CompanyName = COMPANY_NAME;
    Country = COUNTRY;
    City = CITY;
    Mobile = MOBILE;
    LocalLastChanged = LOCAL_LAST_CHANGED;
    LastChanged = LAST_CHANGED;
    LocalChangedBy = LOCAL_CHANGED_BY;
    LastChangedBy = LAST_CHANGED_BY;
  }

}